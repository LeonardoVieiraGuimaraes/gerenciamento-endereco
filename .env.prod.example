# Modelo do .env usado em produção pelo docker-compose.prod.yml.
# NÃO commitar o .env real — ele é criado no servidor pelo próprio workflow de
# deploy (.github/workflows/deploy.yml), a partir dos GitHub Secrets do repositório.

SQL_SA_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# Precisam bater exatamente com os secrets configurados nos clients do realm
# (auth-keycloak/realm/gerenciamento-endereco-realm.json) — o Keycloak importa
# esses valores no boot, então o app só autentica se os dois lados coincidirem.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Servidor de e-mail — sem ele não existe "Esqueci minha senha": o Keycloak
# precisa de SMTP para enviar o link de redefinição. Serve qualquer provedor
# (Brevo, Resend, etc.); em desenvolvimento o padrão é o capturador local.
# Endereco e porta do provedor ficam no docker-compose.prod.yml — nao sao
# segredo. Aqui so as credenciais e o remetente.
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
