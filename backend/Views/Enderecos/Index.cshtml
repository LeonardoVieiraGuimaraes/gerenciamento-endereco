@model IEnumerable<GerenciamentoEndereco.API.Models.Endereco>

@{
    var title = ViewData["TargetNome"] != null ? $"Endereços: {ViewData["TargetNome"]}" : "Meus Endereços";
    ViewData["Title"] = title;
    var isAllView = ViewData["IsAllView"] as bool? == true;
}

<div class="glass-card fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-map me-2"></i>@title</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold me-2">
                <i class="bi bi-plus-circle me-1"></i> Novo Endereço
            </a>
            <a asp-action="ExportCsv" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    @if (isAllView)
                    {
                        <th><i class="bi bi-person me-1"></i>Usuário</th>
                    }
                    <th><i class="bi bi-geo me-1"></i>CEP</th>
                    <th>Logradouro</th>
                    <th>Número</th>
                    <th>Bairro</th>
                    <th>Cidade / UF</th>
                    <th><i class="bi bi-gear me-1"></i>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (isAllView)
                        {
                            <td class="fw-bold var-text-primary">
                                <i class="bi bi-person-circle me-1"></i>@(item.Usuario?.Nome ?? item.Usuario?.Username ?? "N/A")
                            </td>
                        }
                        <td><span class="badge bg-secondary rounded-pill">@item.Cep</span></td>
                        <td class="fw-medium">@item.Logradouro</td>
                        <td>@item.Numero</td>
                        <td>@item.Bairro</td>
                        <td>@item.Cidade - @item.Uf</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill me-1">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill">
                                <i class="bi bi-trash me-1"></i> Excluir
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(isAllView ? 7 : 6)" class="text-center p-5 var-text-muted">
                            <i class="bi bi-geo-alt fs-1 d-block mb-2"></i>
                            Nenhum endereço cadastrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
