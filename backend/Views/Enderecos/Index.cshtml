@model IEnumerable<GerenciamentoEndereco.API.Models.Endereco>

@{
    var title = ViewData["TargetNome"] != null ? $"Endereços: {ViewData["TargetNome"]}" : "Meus Endereços";
    ViewData["Title"] = title;
    var isAllView = ViewData["IsAllView"] as bool? == true;
    var filtroNomeEditavel = ViewData["FiltroNomeEditavel"] as bool? == true;
}

<div class="glass-card fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-map me-2"></i>@title</h2>
        <div>
            <a asp-action="Create" class="btn-app btn-app-primary btn-app-sm me-2">
                <i class="bi bi-plus-circle"></i> Novo Endereço
            </a>
            <a asp-action="ExportCsv" class="btn-app btn-app-success btn-app-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i> Exportar CSV
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4 align-items-end">
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label small var-text-muted mb-1">Nome</label>
            @if (filtroNomeEditavel)
            {
                <input type="text" name="nome" value="@ViewData["FiltroNome"]" class="form-control form-control-sm" placeholder="Buscar por usuário..." />
            }
            else
            {
                <input type="text" value="@ViewData["FiltroNome"]" class="form-control form-control-sm" disabled title="Restrito ao seu próprio usuário" />
            }
        </div>
        <div class="col-6 col-md-2 col-lg-2">
            <label class="form-label small var-text-muted mb-1">CEP</label>
            <input type="text" name="cep" value="@ViewData["FiltroCep"]" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-3 col-lg-3">
            <label class="form-label small var-text-muted mb-1">Logradouro</label>
            <input type="text" name="logradouro" value="@ViewData["FiltroLogradouro"]" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2 col-lg-2">
            <label class="form-label small var-text-muted mb-1">Cidade</label>
            <input type="text" name="cidade" value="@ViewData["FiltroCidade"]" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-1 col-lg-1">
            <label class="form-label small var-text-muted mb-1">UF</label>
            <input type="text" name="uf" value="@ViewData["FiltroUf"]" maxlength="2" class="form-control form-control-sm text-uppercase" />
        </div>
        <div class="col-12 col-md-3 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn-app btn-app-primary btn-app-sm">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            @* Mantém o usuário selecionado ao limpar: quem está vendo os endereços
               de outra pessoa continua nela, limpando só CEP/logradouro/cidade/UF. *@
            <a asp-action="Index" asp-route-username="@ViewData["TargetUsername"]"
               class="btn-app btn-app-outline btn-app-sm">
                <i class="bi bi-eraser"></i> Limpar
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    @if (isAllView)
                    {
                        <th><i class="bi bi-person me-1"></i>Usuário</th>
                    }
                    <th><i class="bi bi-geo me-1"></i>CEP</th>
                    <th>Logradouro</th>
                    <th>Número</th>
                    <th>Bairro</th>
                    <th>Cidade / UF</th>
                    <th class="text-center"><i class="bi bi-trash me-1"></i>Excluir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (isAllView)
                        {
                            <td class="fw-bold var-text-primary">
                                <i class="bi bi-person-circle me-1"></i>@(item.Usuario?.Nome ?? item.Usuario?.Username ?? "N/A")
                            </td>
                        }
                        <td><span class="badge bg-secondary rounded-pill">@item.Cep</span></td>
                        <td>
                            @* O logradouro identifica a linha e leva para a edição —
                               mesma lógica do nome na tela de usuários. *@
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="link-nome" title="Editar endereço">@item.Logradouro</a>
                        </td>
                        <td>@item.Numero</td>
                        <td>@item.Bairro</td>
                        <td>@item.Cidade - @item.Uf</td>
                        <td class="text-center">
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn-app btn-app-danger btn-app-icon btn-app-sm"
                               title="Excluir endereço">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(isAllView ? 7 : 6)" class="text-center p-5 var-text-muted">
                            <i class="bi bi-geo-alt fs-1 d-block mb-2"></i>
                            Nenhum endereço cadastrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
