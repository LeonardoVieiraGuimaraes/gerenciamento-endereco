@model GerenciamentoEndereco.API.Models.Endereco

@{
    ViewData["Title"] = "Excluir Endereço";
}

<div class="glass-card fade-in" style="max-width: 720px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-exclamation-triangle text-danger me-2"></i>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Tem certeza de que deseja excluir este endereço? Essa ação é irreversível.
    </div>

    <dl class="row">
        <dt class="col-sm-3">CEP</dt>
        <dd class="col-sm-9">@Model.Cep</dd>
        <dt class="col-sm-3">Logradouro</dt>
        <dd class="col-sm-9">@Model.Logradouro, @Model.Numero</dd>
        <dt class="col-sm-3">Bairro</dt>
        <dd class="col-sm-9">@Model.Bairro</dd>
        <dt class="col-sm-3">Cidade / UF</dt>
        <dd class="col-sm-9">@Model.Cidade - @Model.Uf</dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
            <i class="bi bi-trash me-1"></i> Excluir Definitivamente
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
    </form>
</div>
