<!DOCTYPE html>
<html lang="pt-BR">
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gerenciamento de Endereços</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GerenciamentoEndereco.API.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm glass-nav mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold var-text-primary d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-geo-alt-fill fs-4"></i> Gerenciamento de Endereços
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter: var(--icon-filter);"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link var-text-main fw-medium" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link var-text-main fw-bold" asp-area="" asp-controller="Enderecos" asp-action="Index">
                                    <i class="bi bi-geo-alt me-1"></i> Endereços
                                </a>
                            </li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, null, "UsuariosManage")).Succeeded)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle var-text-main fw-medium" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Administração
                                </a>
                                <ul class="dropdown-menu glass-dropdown border-0 shadow-sm" aria-labelledby="adminDropdown">
                                    <li><h6 class="dropdown-header">Gestão</h6></li>
                                    <li>
                                        <a class="dropdown-item fw-medium" asp-area="" asp-controller="Usuarios" asp-action="Index">
                                            <i class="bi bi-people me-2 text-primary"></i> Gerenciar Usuários
                                        </a>
                                    </li>
                                    @if ((await AuthorizationService.AuthorizeAsync(User, null, "DocsRead")).Succeeded)
                                    {
                                        <li>
                                            <a class="dropdown-item fw-medium" asp-area="" asp-controller="Home" asp-action="Docs">
                                                <i class="bi bi-file-earmark-text me-2 text-info"></i> Documentação da API
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Avançado</h6></li>
                                    <li>
                                        <a class="dropdown-item fw-medium" href="http://localhost:8089/admin/gerenciamento-endereco/console/" target="_blank">
                                            <i class="bi bi-box-arrow-up-right me-2 text-muted"></i> Console do Keycloak
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link var-text-main fw-medium" asp-area="" asp-controller="Home" asp-action="Sobre">
                                <i class="bi bi-info-circle me-1"></i> Sobre
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-3 d-flex align-items-center">
                            <button id="theme-toggle" class="btn-app btn-app-outline btn-app-icon btn-app-sm" title="Alternar Tema">
                                <i class="bi bi-moon-stars-fill" id="theme-icon"></i>
                            </button>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var nameClaim = User.FindFirst("name")?.Value
                                        ?? User.FindFirst("preferred_username")?.Value
                                        ?? User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                                        ?? User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                                        ?? User.Identity?.Name;
                            var displayName = !string.IsNullOrWhiteSpace(nameClaim) ? nameClaim : "Usuário";
                            var firstName = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? displayName;
                            var iniciais = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 var-text-main fw-medium" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="d-flex align-items-center justify-content-center fw-bold rounded-circle"
                                          style="width: 30px; height: 30px; background: var(--btn-primary); color: #fff; font-size: 0.75rem; flex-shrink: 0;">
                                        @iniciais
                                    </span>
                                    <span class="d-none d-md-inline">@firstName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end glass-dropdown border-0 shadow-sm" aria-labelledby="userDropdown" style="min-width: 220px;">
                                    <li class="px-3 py-2">
                                        <div class="fw-bold var-text-main text-truncate">@displayName</div>
                                        <div class="small var-text-muted text-truncate">
                                            @(User.FindFirst("email")?.Value
                                              ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                                              ?? User.FindFirst("preferred_username")?.Value)
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item fw-medium" asp-controller="Auth" asp-action="Perfil">
                                            <i class="bi bi-person-circle me-2 text-primary"></i> Meu Perfil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item fw-medium text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sair
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-premium btn-sm px-4" asp-area="" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="glass-footer text-muted text-center py-3 mt-auto">
        <div class="container">
            &copy; 2026 &nbsp;&mdash;&nbsp; <strong>Gerenciamento de Endereços</strong> &nbsp;&mdash;&nbsp; Desenvolvido com <i class="bi bi-code-slash mx-1 var-text-primary"></i> e .NET 8
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
