@model GerenciamentoEndereco.API.Services.CreateAuthentikUserRequest
@{
    ViewData["Title"] = "Criar Usuário";
}

<div class="glass-card fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-plus me-2"></i>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Por favor, corrija os erros abaixo.
            <div asp-validation-summary="All" class="text-danger mt-2 mb-0"></div>
        </div>
    }

    <form asp-action="Create" method="post" class="needs-validation">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-bold">Nome completo</label>
                <input asp-for="Name" class="form-control" placeholder="João Silva" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="joao@exemplo.com" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Username" class="form-label fw-bold">Nome de Usuário</label>
                <input asp-for="Username" class="form-control" placeholder="joaosilva" required />
            </div>

            <div class="col-md-12">
                <label asp-for="Password" class="form-label fw-bold">Senha Inicial</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Defina a senha que o usuário usará para acessar..." required />
                <small class="text-muted">No futuro, o usuário poderá redefinir essa senha.</small>
            </div>
        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="bi bi-check-circle me-1"></i> Criar Usuário
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
