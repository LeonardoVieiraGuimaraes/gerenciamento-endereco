@model GerenciamentoEndereco.API.Services.KeycloakUser
@{
    ViewData["Title"] = "Excluir Usuário";
}

<div class="glass-card fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-exclamation-triangle text-danger me-2"></i>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Tem certeza de que deseja excluir <strong>@(string.IsNullOrWhiteSpace(Model.Name) ? Model.Username : Model.Name)</strong>
        (@Model.Username)? Essa ação é irreversível e remove o acesso do usuário ao sistema.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Nome de usuário</dt>
        <dd class="col-sm-9">@Model.Username</dd>
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">E-mail</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
            <i class="bi bi-trash me-1"></i> Excluir Definitivamente
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
    </form>
</div>
