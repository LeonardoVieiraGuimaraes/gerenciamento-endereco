@model IEnumerable<GerenciamentoEndereco.API.Models.ViewModels.UsuarioListViewModel>
@{
    ViewData["Title"] = "Usuários Registrados";
}

<div class="glass-card fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people me-2"></i>@ViewData["Title"]</h2>
        <div>
            <span class="badge bg-primary rounded-pill fs-6 me-2">@Model.Count() usuários</span>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                <i class="bi bi-person-plus me-1"></i> Novo Usuário
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th><i class="bi bi-person me-1"></i>Nome</th>
                    <th><i class="bi bi-at me-1"></i>Usuário / E-mail</th>
                    <th><i class="bi bi-shield me-1"></i>Status</th>
                    <th><i class="bi bi-geo-alt me-1"></i>Endereços</th>
                    <th class="text-center"><i class="bi bi-shield-lock me-1"></i>Keycloak</th>
                    <th class="text-center"><i class="bi bi-trash me-1"></i>Excluir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="fw-medium var-text-main text-decoration-none"
                               title="Editar Usuário">
                                <i class="bi bi-pencil-square me-1 var-text-primary"></i>@item.Nome
                            </a>
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <small class="var-text-main fw-bold">@item.Username</small>
                                <small class="var-text-muted">@item.Email</small>
                            </div>
                        </td>
                        <td>
                            @if (item.Enabled)
                            {
                                <span class="badge bg-success rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i>Ativo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill">
                                    <i class="bi bi-x-circle-fill me-1"></i>Inativo
                                </span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Enderecos" asp-action="Index" asp-route-username="@item.Username"
                               class="badge bg-secondary rounded-pill text-decoration-none"
                               title="Ver e Editar Endereços do Usuário">
                                <i class="bi bi-geo-alt-fill me-1"></i>@item.EnderecoCount
                            </a>
                        </td>
                        <td class="text-center">
                            <a href="http://localhost:8089/admin/gerenciamento-endereco/console/#/gerenciamento-endereco/users/@item.Id/settings"
                               target="_blank"
                               class="btn btn-sm btn-outline-primary rounded-circle"
                               title="Abrir no Console Admin do Keycloak">
                                <i class="bi bi-shield-lock"></i>
                            </a>
                        </td>
                        <td class="text-center">
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger rounded-circle"
                               title="Excluir Usuário">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center p-5">
                <i class="bi bi-people fs-1 var-text-muted"></i>
                <p class="mt-3 var-text-muted">Nenhum usuário registrado ainda.</p>
            </div>
        }
    </div>
</div>
