@model GerenciamentoEndereco.API.Models.ViewModels.EditUsuarioViewModel
@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="glass-card fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-gear me-2"></i>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn-app btn-app-outline btn-app-sm">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Por favor, corrija os erros abaixo.
            <div asp-validation-summary="All" class="text-danger mt-2 mb-0"></div>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.KeycloakId" method="post" class="needs-validation">
        <input type="hidden" asp-for="KeycloakId" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Nome de usuário</label>
                <input value="@Model.Username" class="form-control" disabled />
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-bold">Nome</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="NovaSenha" class="form-label fw-bold">Nova Senha</label>
                <input asp-for="NovaSenha" type="password" class="form-control" placeholder="Deixe em branco para manter a atual" />
            </div>

            <div class="col-md-12">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label fw-bold">Usuário Ativo</label>
                </div>
            </div>
        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn-app btn-app-primary">
                <i class="bi bi-check-circle me-1"></i> Salvar Alterações
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
