@model GerenciamentoEndereco.API.Models.ViewModels.PerfilViewModel
@{
    ViewData["Title"] = "Minha Conta";
    var iniciais = string.Concat(Model.Nome.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpper(p[0])));
}

<div class="glass-card fade-in" style="max-width: 720px; margin: 0 auto;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center justify-content-center fw-bold"
             style="width: 64px; height: 64px; border-radius: 50%; background: var(--btn-primary); color: #fff; font-size: 1.4rem;">
            @iniciais
        </div>
        <div>
            <h2 class="mb-0">Olá, @Model.Nome!</h2>
            <span class="var-text-muted">@@@Model.Username</span>
        </div>
    </div>

    <hr class="my-4" style="border-color: var(--glass-border);" />

    <dl class="row mb-0">
        <dt class="col-sm-3 var-text-muted"><i class="bi bi-person me-1"></i> Nome</dt>
        <dd class="col-sm-9 fw-medium">@Model.Nome</dd>

        <dt class="col-sm-3 var-text-muted"><i class="bi bi-at me-1"></i> Nome de usuário</dt>
        <dd class="col-sm-9 fw-medium">@Model.Username</dd>

        <dt class="col-sm-3 var-text-muted"><i class="bi bi-envelope me-1"></i> E-mail</dt>
        <dd class="col-sm-9 fw-medium">@Model.Email</dd>

        <dt class="col-sm-3 var-text-muted"><i class="bi bi-shield me-1"></i> Perfil</dt>
        <dd class="col-sm-9">
            @if (Model.Roles.Any())
            {
                foreach (var role in Model.Roles)
                {
                    <span class="badge bg-primary rounded-pill me-1">@role</span>
                }
            }
            else
            {
                <span class="var-text-muted">Usuário padrão</span>
            }
        </dd>

        <dt class="col-sm-3 var-text-muted"><i class="bi bi-geo-alt me-1"></i> Endereços</dt>
        <dd class="col-sm-9">
            <a asp-controller="Enderecos" asp-action="Index" class="fw-bold var-text-primary text-decoration-none">
                @Model.EnderecoCount cadastrado(s) &rarr;
            </a>
        </dd>
    </dl>

    <hr class="my-4" style="border-color: var(--glass-border);" />

    <div class="d-flex flex-wrap gap-2">
        <a href="http://localhost:8089/realms/gerenciamento-endereco/account/#/security/signing-in" target="_blank" class="btn btn-outline-primary rounded-pill px-3 fw-bold">
            <i class="bi bi-key me-1"></i> Senha e Autenticação em 2 Fatores
        </a>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">
                <i class="bi bi-box-arrow-right me-1"></i> Sair
            </button>
        </form>
    </div>
</div>
