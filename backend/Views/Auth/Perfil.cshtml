@model GerenciamentoEndereco.API.Models.ViewModels.PerfilViewModel
@{
    ViewData["Title"] = "Minha Conta";
    var iniciais = string.Concat(Model.Nome.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpper(p[0])));
}

<div class="glass-card fade-in" style="max-width: 720px; margin: 0 auto;">

    @* Cabeçalho: identidade completa (nome, usuário e perfis) num só bloco.
       Antes o nome e o usuário se repetiam logo abaixo, na lista de dados. *@
    <div class="perfil-header">
        <div class="perfil-avatar">@iniciais</div>
        <div class="perfil-identidade">
            <h2 class="perfil-nome">@Model.Nome</h2>
            <p class="perfil-username">&#64;@Model.Username</p>
            <div class="perfil-roles">
                @if (Model.Roles.Any())
                {
                    foreach (var role in Model.Roles)
                    {
                        <span class="badge bg-primary rounded-pill">@role</span>
                    }
                }
                else
                {
                    <span class="badge bg-secondary rounded-pill">Usuário padrão</span>
                }
            </div>
        </div>
    </div>

    <div class="perfil-cards">
        <div class="perfil-card">
            <span class="perfil-card-label">
                <i class="bi bi-envelope"></i> E-mail
            </span>
            <span class="perfil-card-valor">@Model.Email</span>
        </div>

        @* Passa o usuário explicitamente: sem isso, um ADMIN cairia na visão
           "todos os usuários" em vez de ver só os endereços do próprio perfil. *@
        <a asp-controller="Enderecos" asp-action="Index" asp-route-username="@Model.Username"
           class="perfil-card perfil-card-link">
            <span class="perfil-card-label">
                <i class="bi bi-geo-alt"></i> Endereços cadastrados
            </span>
            <span class="perfil-card-valor">
                @Model.EnderecoCount
                <i class="bi bi-arrow-right perfil-card-seta"></i>
            </span>
        </a>
    </div>

    <section class="perfil-secao">
        <h3 class="perfil-secao-titulo">Segurança da conta</h3>
        <p class="perfil-secao-desc">
            Senha e verificação em duas etapas são gerenciadas com segurança pelo Keycloak.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Auth" asp-action="AlterarSenha" class="btn-app btn-app-outline">
                <i class="bi bi-key"></i> Alterar Senha
            </a>
            @if (Model.PossuiDoisFatores)
            {
                <form asp-controller="Auth" asp-action="RemoverDoisFatores" method="post" class="m-0">
                    <button type="submit" class="btn-app btn-app-outline"
                            onclick="return confirm('Remover a verificação em duas etapas? Sua conta passará a exigir apenas a senha para entrar.');">
                        <i class="bi bi-shield-slash"></i> Desativar 2FA
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Auth" asp-action="ConfigurarDoisFatores" class="btn-app btn-app-outline">
                    <i class="bi bi-shield-lock"></i> Configurar 2FA
                </a>
            }
            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 ms-auto">
                <button type="submit" class="btn-app btn-app-danger">
                    <i class="bi bi-box-arrow-right"></i> Sair
                </button>
            </form>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-warning mt-3 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            </div>
        }
    </section>
</div>
