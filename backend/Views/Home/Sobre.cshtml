@{
    ViewData["Title"] = "Sobre";
}

<div class="fade-in">
    <!-- Hero -->
    <div class="text-center mb-5">
        <div class="glass-card mx-auto py-5 slide-up-anim" style="max-width: 720px;">
            <i class="bi bi-geo-alt-fill var-text-primary" style="font-size: 3.5rem;"></i>
            <h1 class="fw-bold mt-3 var-text-primary">Gerenciamento de Endereços</h1>
            <p class="lead var-text-muted mt-3 px-3">
                Sua plataforma para organizar, salvar e consultar endereços de forma simples, segura e rápida.
            </p>
        </div>
    </div>

    <!-- O que você pode fazer -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="glass-card h-100 text-center py-4 slide-up-anim">
                <i class="bi bi-plus-circle-fill var-text-primary mb-3" style="font-size: 2.2rem;"></i>
                <h5 class="fw-bold">Cadastrar endereços</h5>
                <p class="var-text-muted small">
                    Basta digitar o CEP e o sistema preenche automaticamente o logradouro, bairro, cidade e estado pra você.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card h-100 text-center py-4 slide-up-anim" style="animation-delay: 0.1s;">
                <i class="bi bi-shield-lock-fill var-text-primary mb-3" style="font-size: 2.2rem;"></i>
                <h5 class="fw-bold">Privacidade garantida</h5>
                <p class="var-text-muted small">
                    Cada usuário vê somente os seus próprios endereços. Ninguém acessa os dados do outro.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card h-100 text-center py-4 slide-up-anim" style="animation-delay: 0.2s;">
                <i class="bi bi-download var-text-primary mb-3" style="font-size: 2.2rem;"></i>
                <h5 class="fw-bold">Exportar para planilha</h5>
                <p class="var-text-muted small">
                    Você pode baixar todos os seus endereços em formato CSV para usar em qualquer planilha.
                </p>
            </div>
        </div>
    </div>

    <!-- Como usar -->
    <div class="glass-card mb-5 slide-up-anim" style="animation-delay: 0.3s;">
        <h4 class="fw-bold mb-4"><i class="bi bi-lightbulb-fill me-2 var-text-primary"></i>Como usar</h4>
        <div class="row g-3">
            <div class="col-md-3 text-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                     style="width:52px;height:52px;background:var(--accent-color);color:#fff;font-weight:700;font-size:1.2rem;">1</div>
                <p class="small fw-medium var-text-main">Faça login com seu usuário e senha</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                     style="width:52px;height:52px;background:var(--accent-color);color:#fff;font-weight:700;font-size:1.2rem;">2</div>
                <p class="small fw-medium var-text-main">Vá em <strong>Endereços → Novo</strong></p>
            </div>
            <div class="col-md-3 text-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                     style="width:52px;height:52px;background:var(--accent-color);color:#fff;font-weight:700;font-size:1.2rem;">3</div>
                <p class="small fw-medium var-text-main">Digite o CEP e aguarde o preenchimento automático</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                     style="width:52px;height:52px;background:var(--accent-color);color:#fff;font-weight:700;font-size:1.2rem;">4</div>
                <p class="small fw-medium var-text-main">Salve e pronto! Seu endereço está registrado.</p>
            </div>
        </div>
    </div>

    <!-- Dúvidas -->
    <div class="glass-card text-center py-4 slide-up-anim" style="animation-delay: 0.4s;">
        <i class="bi bi-headset var-text-primary mb-2" style="font-size: 2rem;"></i>
        <h5 class="fw-bold">Precisa de ajuda?</h5>
        <p class="var-text-muted small mb-0">
            Entre em contato com o administrador do sistema para suporte ou dúvidas sobre o seu acesso.
        </p>
    </div>
</div>
